# ============================================================
# .env.example — 所有需要的环境变量
# 复制为 .env 并填写你自己的值
# 所有脚本统一从 workspace 根目录加载此文件（见 tools/workspace_path.py / tools/workspace_env.py）
# ============================================================

# Gmail（用于 send_email / crontab_monitor 告警邮件）
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
GMAIL_RECIPIENTS=

# OpenCode Server（用于 observer / reflector / ai_news_survey / crontab_monitor）
OPENCODE_BASE_URL=http://localhost:4096
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=
# OPENCODE_MESSAGE_TIMEOUT=3600

# Google Analytics 4（用于 ga4_metrics.py）
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Kit / ConvertKit（用于 kit_metrics.py 和 newsletter 发布）
KIT_API_KEY=
# KIT_BASE_URL=https://api.kit.com/v4
# KIT_TIMEOUT=30

# Typefully posting（用于 typefully_post.py）
TYPEFULLY_API_KEY=
TYPEFULLY_SOCIAL_SET_ID=

# Typefully metrics（用于 typefully_metrics.py，需从浏览器抓取）
TYPEFULLY_AUTHORIZATION=
TYPEFULLY_ACCOUNT=
TYPEFULLY_SESSION=
# TYPEFULLY_COOKIE=
# TYPEFULLY_BASE_URL=https://api.typefully.com
# TYPEFULLY_TIMEOUT=30

# Gemini（用于图片生成）
GEMINI_API_KEY=

# 可选：Google 兼容变量（用于 Gemini）
GOOGLE_API_KEY=

# 图片生成模型覆盖（可选）
IMAGE_GENERATION_MODEL=
GEMINI_FLASH_IMAGE_MODEL=
GEMINI_PRO_IMAGE_MODEL=
GEMINI_IMAGE_GENERATION_MODEL=
GEMINI_IMAGE_UPSCALE_MODEL=
OPENAI_IMAGE_MODEL=

# OpenAI（用于 semantic_search 本地 embedding）
OPENAI_API_KEY=

# Tavily（用于 web search / extract；AI News Survey 调研）
TAVILY_API_KEY=
